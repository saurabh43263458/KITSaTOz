# ==========================================
# KITSaTOz E-Commerce Configuration
# ==========================================

# 1. WhatsApp Configuration (Required for WhatsApp Order Routing)
# Format: Country code followed by phone number (e.g., 919876543210 for India)
VITE_WHATSAPP_NUMBER=919876543210

# 2. Store Owner / Admin Email (Where order notifications & admin access default to)
VITE_ADMIN_EMAIL=admin@kitsatoz.com

# 3. Optional Email Service Integration (Web3Forms access key)
# Get a free access key from https://web3forms.com
VITE_WEB3FORMS_KEY=

# 4. Optional Firebase Configuration
# If left blank, the app runs in full-featured Local/Demo mode with instant testing accounts!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
